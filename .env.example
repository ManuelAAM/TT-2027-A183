# Configuración de conexión a PostgreSQL (TT-2027-A183)
# Copia este archivo como .env y cambia la contraseña. El archivo .env no se sube a Git.
MONITOREO_DB_HOST=localhost
MONITOREO_DB_PORT=5432
MONITOREO_DB_NAME=monitoreo_red
MONITOREO_DB_USER=monitoreo_app
MONITOREO_DB_PASSWORD=cambia_esta_contrasena
